{
  "name": "@laundry-plugs/api",
  "version": "0.0.1",
  "private": true,
  "description": "API that collects Shelly plug readings for Laundry Plugs",
  "author": "Aleks-Daniel Jakimenko-Aleksejev <alex.jakimenko@gmail.com>",
  "type": "module",
  "scripts": {
    "check": "tsgo --noEmit",
    "lint": "oxlint submodules",
    "lint:fix": "oxlint submodules --fix",
    "lint-slow": "pnpm run lint",
    "dev": "NODE_ENV=development tsx watch submodules/main/index.ts",
    "start": "tsx submodules/main/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@hono/zod-validator": "0.9.1",
    "@laundry-plugs/database": "workspace:*",
    "drizzle-orm": "1.0.0-beta.22",
    "hono": "4.13.18",
    "loglevel": "1.9.2",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "26.13.1"
  }
}
